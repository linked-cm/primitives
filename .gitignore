# Compiled artifacts from tsc should live in lib/, never under src/.
# This repo has no hand-written .js under src/, so the whole family is ignored.
# A repo that does keep a legit .js helper there must un-ignore it explicitly.
src/**/*.d.ts
src/**/*.js
src/**/*.js.map
